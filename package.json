{
  "name": "mapfix",
  "version": "1.0.0",
  "description": "Mapfix — веб-додаток з картою та каталогом послуг",
  "main": "server.js",
  "scripts": {
    "dev": "node scripts/free-port.js && node server.js",
    "start": "node scripts/free-port.js && node server.js",
    "start:node": "node server.js",
    "check": "node scripts/architecture-check.js",
    "db:sync": "node scripts/sync-database.js",
    "db:verify": "node scripts/verify-database-schema.js",
    "db:harden": "node scripts/apply-security-hardening.js",
    "test": "node --test test/*.test.js",
    "import:places": "node scripts/import-places.js",
    "import:wave-a": "node scripts/import-places-v2.js --wave A",
    "import:wave-a:plan": "node scripts/import-places-v2.js --wave A --plan",
    "import:backfill-place-ids": "node scripts/backfill-google-place-ids.js",
    "import:kotsyubynske": "node scripts/import-places.js --source osm --city kotsyubynske --category beauty --write"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3"
  }
}
