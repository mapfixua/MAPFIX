# Supabase (required for app)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional: service role for admin writes (keep secret)
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — for npm run db:sync
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# JWT / sessions
# JWT_SECRET=change-me-in-production

# Telegram bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=Mapfix_auth_bot
