# Supabase (required for app)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional: service role for admin writes (keep secret)
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — for npm run db:sync
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# JWT / sessions
# JWT_SECRET=change-me-in-production

# Telegram bot (REQUIRED for OTP login + account linking)
# Get token from @BotFather, username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Mapfix_auth_bot
# Local: polling (default). Production: webhook + PUBLIC_BASE_URL
# TELEGRAM_MODE=polling
# PUBLIC_BASE_URL=https://mapfix-wine.vercel.app

# Optional: Google Places API for admin + provider Google import
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Optional: email password reset (Resend)
# RESEND_API_KEY=
# RESET_EMAIL_FROM=Mapfix <noreply@yourdomain.com>
# PUBLIC_BASE_URL=https://mapfix-wine.vercel.app

# Optional: Google Sign-In (Web Client ID from Google Cloud Console)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Optional: Sign in with Apple (Services ID)
# APPLE_CLIENT_ID=com.yourapp.web
# APPLE_CLIENT_ID_IOS=com.yourapp.ios
# VITE_APPLE_CLIENT_ID=com.yourapp.web
