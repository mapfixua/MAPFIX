{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "public/**",
          "data.json",
          "orders.json",
          "favorites.json",
          "server.js",
          "paths.js",
          "auth-jwt.js",
          "supabaseClient.js",
          "telegram-auth.js",
          "telegram-bot.js",
          "password-reset.js",
          "oauth-auth.js",
          "catalog-store.js",
          "locations-store.js",
          "provider-profiles-store.js",
          "catalog-clicks-store.js",
          "location-photos.js",
          "places-import.js",
          "otp-auth.js",
          "routes/**",
          "catalog-data.js",
          "search-ai.js",
          "app-state-store.js",
          "kv-store.js",
          "rate-limit.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
